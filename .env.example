# ==============================================================================
# AegisGate Core Environment Configuration (.env.example)
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# --- General System ---
# Display name of the AegisGate application
APP_NAME=AegisGate Core

# Semantic application version
APP_VERSION=1.0.0

# Enable debug mode (verbose SQL logging and stack traces). Default: false
DEBUG=false

# --- Server Network ---
# Host interface for the FastAPI REST gateway to bind to. Default: 127.0.0.1
API_HOST=127.0.0.1

# HTTP port for the FastAPI REST gateway. Default: 8000
API_PORT=8000

# Network port allocated for standalone FastMCP service. Default: 8001
MCP_PORT=8001

# --- Storage Paths ---
# Root directory of the repository (defaults to project root containing core/)
# BASE_DIR=

# Directory containing runtime SQLite data and knowledge artifacts
# DATA_DIR=

# SQLAlchemy connection string for AegisGate Core metadata store
DATABASE_URL=sqlite:///data/aegisgate.db

# Directory containing markdown knowledge context (doc.md, skills.md)
# KNOWLEDGE_DOCS_DIR=

# Directory containing registered plugin directories and templates
# PLUGINS_DIR=

# --- Execution Timeout Guards ---
# Strict timeout limit (seconds) for read-only analytical queries. Default: 15.0
READ_TIMEOUT_SECONDS=15.0

# Strict timeout limit (seconds) for state-mutating write queries. Default: 30.0
WRITE_TIMEOUT_SECONDS=30.0

# Default timeout fallback when query intent cannot be classified. Default: 15.0
DEFAULT_TIMEOUT_SECONDS=15.0

# --- Dry-Run Failure Behavior ---
# If a plugin dry-run inspection crashes:
# true  = Reject query immediately (fail-closed, recommended for security).
# false = Force query into manual review (PAUSED_FOR_REVIEW) without auto-approval.
FAIL_CLOSED_ON_DRY_RUN_ERROR=true

# --- Plugin Installer Security Limits ---
# Allowed HTTPS host domains for Git plugin installation (JSON list syntax)
PLUGIN_GIT_ALLOWED_HOSTS=["github.com", "gitlab.com", "bitbucket.org"]

# Maximum allowed size (bytes) for uploaded plugin ZIP archives. Default: 52428800 (50MB)
PLUGIN_MAX_ZIP_BYTES=52428800

# Maximum expanded size (bytes) for unzipped plugin directory. Default: 209715200 (200MB)
PLUGIN_MAX_UNZIPPED_BYTES=209715200

# Maximum number of file entries allowed inside a plugin ZIP archive. Default: 5000
PLUGIN_MAX_ZIP_ENTRIES=5000

# Timeout limit (seconds) for git clone operations during plugin installation. Default: 60.0
PLUGIN_GIT_CLONE_TIMEOUT_SECONDS=60.0

# --- Worker Process Limits ---
# Maximum payload size (bytes) for a single JSON-RPC message over Stdio. Default: 67108864 (64MB)
PLUGIN_MAX_MESSAGE_BYTES=67108864

# --- Human-In-The-Loop Approval Defaults ---
# Default auto-approval mode on startup (true = auto-execute, false = paused for review)
AUTO_APPROVAL_DEFAULT=false

# --- Server-Sent Events (SSE) ---
# Interval in seconds between SSE heartbeat keep-alive messages. Default: 2.0
SSE_HEARTBEAT_INTERVAL_SECONDS=2.0
