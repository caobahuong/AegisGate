# ==============================================================================
# AegisGate Frontend Environment Configuration (.env.example)
# Copy this file to frontend/.env.local for custom backend URL configuration.
# ==============================================================================

# AegisGate Core FastAPI REST API Gateway URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# AegisGate Core Server-Sent Events (SSE) Real-Time Stream URL
NEXT_PUBLIC_SSE_URL=http://127.0.0.1:8000/api/monitor/events

